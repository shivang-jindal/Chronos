{
  "name": "chronos",
  "version": "1.0.0",
  "private": true,
  "description": "Chronos — 4D Temporal Earth Engine. Time-travel globe (1984→2050) with AI forecasting.",
  "license": "MIT",
  "homepage": "https://github.com/shivang-jindal/Chronos#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/shivang-jindal/Chronos.git"
  },
  "bugs": {
    "url": "https://github.com/shivang-jindal/Chronos/issues"
  },
  "keywords": [
    "temporal",
    "earth-engine",
    "time-travel",
    "climate",
    "forecasting",
    "satellite",
    "cesium",
    "react",
    "typescript"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "build:shared": "npm run build -w @chronos/shared",
    "build:server": "npm run build -w @chronos/server",
    "build:client": "npm run build -w @chronos/client",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "typecheck": "npm run build:shared && npm run typecheck -w @chronos/server && npm run typecheck -w @chronos/client",
    "lint": "eslint .",
    "test": "npm run build:shared && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev:server": "npm run dev -w @chronos/server",
    "dev:client": "npm run dev -w @chronos/client",
    "dev": "node scripts/dev.mjs",
    "start": "npm run start -w @chronos/server",
    "smoke": "node scripts/smoke.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.13.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}